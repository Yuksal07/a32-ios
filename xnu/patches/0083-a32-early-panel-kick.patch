diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 01966d5..07d5f81 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -39,6 +39,28 @@ sweet_early_clear_row(void)
 	}
 }
 
+/*
+ * The A32 panel is in DSI command mode: pixels written to the framebuffer
+ * only appear after a transfer is triggered. While the bootstrap V=P map is
+ * live (start.s maps 0x14000000 as device memory) trigger it directly.
+ */
+static unsigned int early_kick_ok = 1;
+
+static void
+sweet_early_kick(void)
+{
+	if (!early_kick_ok) {
+		return;
+	}
+	volatile uint32_t *mutex0 = (volatile uint32_t *)(uintptr_t)0x14001000;
+	volatile uint32_t *dsi0 = (volatile uint32_t *)(uintptr_t)0x14014000;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	mutex0[0x20 / 4] = 1;
+	dsi0[0] = 0;
+	dsi0[0] = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
 void
 sweet_early_putc(char c)
 {
@@ -57,6 +79,7 @@ sweet_early_putc(char c)
 		early_col = 0;
 		early_row = (early_row + 1) % EARLY_ROWS;
 		sweet_early_clear_row();
+		sweet_early_kick();
 		if (c == '\n') {
 			return;
 		}
@@ -107,6 +130,7 @@ sweet_early_mark(unsigned int stage, const char *label)
 	sweet_early_string(": ");
 	sweet_early_string(label);
 	sweet_early_putc('\n');
+	sweet_early_kick();
 }
 
 void
@@ -129,6 +153,7 @@ void
 sweet_early_relocate(uint64_t base)
 {
 	sweet_early_mark(8, "leaving bootstrap TTBR0");
+	early_kick_ok = 0;	/* V=P device map goes away with TTBR0 */
 	early_fb = (volatile uint32_t *)(uintptr_t)(base + 0x720000);	/* FB sits 0x720000 into the 32MB block */
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index e79394d..f2d453f 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -56,6 +56,14 @@ x
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+
+	/* Display controller registers (mutex0 0x14001000, dsi0 0x14014000) as device memory: the command-mode panel needs a trigger to show the framebuffer. */
+	MOV64	x10, 0x14000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
 #endif
 
 	/* Ensure TTEs are visible */
