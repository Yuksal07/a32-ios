+/*
+ * A32: the s6e3fc3 panel is in DSI command mode, it only shows a new frame when the display
+ * pipeline is triggered. The shim does it the way LK does (mutex0 EN, DSI_START 0 -> 1) and that
+ * made its console visible on the phone. Do the same after every completed console line.
+ * mutex0 0x14001000 (+0x20), dsi0 0x14014000 (+0x00). Mapped on first use.
+ */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+static volatile uint32_t *fbcon_kick_mutex, *fbcon_kick_dsi;
+static bool fbcon_kick_tried;
+
+static void
+fbcon_kick(void)
+{
+	if (!fbcon_kick_tried) {
+		fbcon_kick_tried = true;
+		fbcon_kick_mutex = (volatile uint32_t *)ml_io_map(0x14001000UL, 0x1000);
+		fbcon_kick_dsi = (volatile uint32_t *)ml_io_map(0x14014000UL, 0x1000);
+	}
+	if (fbcon_kick_mutex == NULL || fbcon_kick_dsi == NULL) {
+		return;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fbcon_kick_mutex[0x20 / 4] = 1;
+	fbcon_kick_dsi[0] = 0;
+	fbcon_kick_dsi[0] = 1;
+}
